{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 300
    },
    "api/cron/*.js": {
      "maxDuration": 300
    },
    "api/send.js": {
      "maxDuration": 300
    },
    "api/story.js": {
      "maxDuration": 300
    },
    "api/setup-webhook.js": {
      "maxDuration": 60
    },
    "api/business-id.js": {
      "maxDuration": 60
    },
    "api/bito-orders.js": {
      "maxDuration": 300
    },
    "api/dashboard.js": {
      "maxDuration": 120
    },
    "api/igimg.js": {
      "maxDuration": 60
    },
    "api/igvid.js": {
      "maxDuration": 120,
      "includeFiles": "{assets/fonts/**,node_modules/ffmpeg-static/ffmpeg}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 11 * * *"
    }
  ],
  "installCommand": "npm install --no-audit --no-fund && node node_modules/ffmpeg-static/install.js"
}
